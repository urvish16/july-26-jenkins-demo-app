pipeline {
    agent any
        environment {
            DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
            IMAGE_NAME = 'urvishsoni16/jenkins-demo-app'
            IMAGE_TAG = "${env.BUILD_NUMBER}"
        }
    stages {
        stage('Checkout') {
            steps {
            echo 'Repository checked out by Declarative: Checkout SCM'
            }
        }
        stage('Build') {
            steps {
            sh 'java -version && mvn -version'
            sh 'mvn clean package -DskipTests'
            }
        }
        stage('Build Docker Image') {
            steps {
            sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
            }
        }
        stage('Push to Docker Hub') {
            steps {
            withCredentials([usernamePassword(
            credentialsId: 'docker-hub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
            )]) {
            sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
            sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
            }
            }
        }
        stage('Deploy Approval') {
            steps {
            input message: 'Approve deployment to production?', ok: 'Deploy'
            }
        }
        stage('Deploy') {
        steps {
            // Stop and remove any existing container on this port
            sh 'docker stop jenkins-demo-manual || true'
            sh 'docker rm jenkins-demo-manual || true'
            // Host port 8081 → container port 8081 (app listens on 8081)
            sh "docker run -d --name jenkins-demo-manual -p 8081:8081 ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        }
    stage('Verify Deployment') {
        steps {
        sh 'docker ps | grep jenkins-demo-manual'
        sh 'curl -f http://localhost:8081/hello || echo "Health check failed"'
        }
    }
    }
}